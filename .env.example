# Copy this file to .env (or set the same variables in your host's dashboard).
# NEVER commit the real values.

# Your Grok (xAI) API key from https://console.x.ai  (stays on the server)
XAI_API_KEY=

# Model used for reading sheets. Leave empty to use the built-in list
# (grok-4.7, then grok-4.3, then grok-4-1-fast-non-reasoning). Check the current names at console.x.ai.
XAI_MODEL=

# Password for the admin panel at /admin. Use a long random one.
# If you leave it empty, the server generates one and saves it in DATA_DIR/admin-password.txt
ADMIN_PASSWORD=

# Secret used to sign login tokens. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, one is created and saved in DATA_DIR/secret.txt
APP_SECRET=

PORT=3000
DATA_DIR=./data
